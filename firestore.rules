rules_version = '2';

// Règles du Parti du Maroc Émergeant.
// - members/{uid}   : fiche adhérent, lisible par son titulaire, les administrateurs et le coordinateur de sa région.
// - cins/{CIN}      : verrou d'unicité (une CIN = un compte), jamais lisible côté client.
// Aucune pièce d'identité n'est stockée en ligne : l'engagement légalisé, la CIN recto/verso et la fiche électorale
// sont remis en papier au coordinateur régional, qui n'en valide que l'état (engagementStatus, cinRectoStatus, …).
// Premier administrateur : dans la console, mettre role = "admin" sur sa fiche members/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role in ['admin', 'bureau_politique'];
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    // Le nom et la région affichés sur une publication doivent être ceux du profil (pas d'usurpation).
    function authorMatchesProfile() {
      return request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == memberDoc().firstNameFr + ' ' + memberDoc().lastNameFr
        && request.resource.data.authorRegion == memberDoc().province;
    }

    // Mise à jour des compteurs d'un débat : ils doivent refléter exactement le vote du membre.
    function debateVoteCounter(debateId) {
      let votePath = /databases/$(database)/documents/debateVotes/$(debateId + '_' + request.auth.uid);
      let after = existsAfter(votePath) ? getAfter(votePath).data.vote : '';
      let before = exists(votePath) ? get(votePath).data.vote : '';
      return isMember()
        && existsAfter(votePath)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votesFor', 'votesAgainst', 'votesNeutral'])
        && request.resource.data.votesFor == resource.data.votesFor + (after == 'for' ? 1 : 0) - (before == 'for' ? 1 : 0)
        && request.resource.data.votesAgainst == resource.data.votesAgainst + (after == 'against' ? 1 : 0) - (before == 'against' ? 1 : 0)
        && request.resource.data.votesNeutral == resource.data.votesNeutral + (after == 'neutral' ? 1 : 0) - (before == 'neutral' ? 1 : 0);
    }

    function debateCommentCounter() {
      return isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
        && request.resource.data.commentsCount == resource.data.commentsCount + 1;
    }

    // Un sondage ne peut gagner qu'une voix, pour l'option du vote enregistré dans la même opération.
    function pollVoteCounter(pollId) {
      let votePath = /databases/$(database)/documents/pollVotes/$(pollId + '_' + request.auth.uid);
      let option = existsAfter(votePath) ? getAfter(votePath).data.optionId : '';
      return isMember()
        && resource.data.status == 'open'
        && !exists(votePath)
        && existsAfter(votePath)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts', 'totalVotes'])
        && request.resource.data.totalVotes == resource.data.totalVotes + 1
        && request.resource.data.counts.diff(resource.data.counts).affectedKeys().hasOnly([option])
        && request.resource.data.counts[option] == resource.data.counts.get(option, 0) + 1;
    }

    // Coordinateur régional : accès limité aux membres des régions que l'administration lui a attribuées.
    function coordinatesRegion(regionId) {
      return isMember()
        && memberDoc().role == 'regional_coordinator'
        && regionId in memberDoc().get('coordinatorRegions', []);
    }

    // Le coordinateur ne peut changer que l'état des pièces (jamais le rôle, la région, ni sa propre fiche).
    function coordinatorMayDecide(uid) {
      return coordinatesRegion(resource.data.regionId)
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['engagementStatus', 'cinRectoStatus', 'cinVersoStatus', 'electoralStatus'])
        && request.resource.data.get('engagementStatus', 'none') in ['none', 'submitted', 'verified', 'rejected']
        && request.resource.data.get('cinRectoStatus', 'none') in ['none', 'submitted', 'verified', 'rejected']
        && request.resource.data.get('cinVersoStatus', 'none') in ['none', 'submitted', 'verified', 'rejected']
        && request.resource.data.get('electoralStatus', 'none') in ['none', 'submitted', 'verified', 'rejected'];
    }

    // Dossier complet = les quatre pièces validées (condition des scrutins internes).
    function dossierComplete() {
      return memberDoc().get('electoralStatus', 'none') == 'verified'
        && memberDoc().get('engagementStatus', 'none') == 'verified'
        && memberDoc().get('cinRectoStatus', 'none') == 'verified'
        && memberDoc().get('cinVersoStatus', 'none') == 'verified';
    }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin() || coordinatesRegion(resource.data.regionId));
      // Une requête de coordinateur doit filtrer sur sa région : where('regionId', '==', …).
      allow list: if isAdmin() || (signedIn() && coordinatesRegion(resource.data.regionId));

      // Inscription : l'adhérent crée sa propre fiche, avec le rôle le plus bas, sans titre ni pièce « validée »,
      // et une CIN verrouillée à son compte (une CIN = un compte).
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['membershipNumber', 'firstNameFr', 'lastNameFr', 'firstNameAr', 'lastNameAr',
             'cin', 'email', 'phone', 'birthDate', 'gender', 'regionId', 'province', 'commune', 'profession', 'photoUrl',
             'commissionInterest', 'joinedDate', 'validUntil', 'contributionBadge', 'role', 'status',
             'isElectorallyVerified', 'isEmailVerified', 'electoralStatus', 'createdAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.electoralStatus == 'none'
        && request.resource.data.isElectorallyVerified == false
        && request.resource.data.isEmailVerified == false
        && request.resource.data.contributionBadge == 'Adhérent Émergeant'
        && request.resource.data.cin.matches('[A-Z]{1,2}[0-9]{4,6}')
        && request.resource.data.photoUrl.size() < 200000
        && existsAfter(/databases/$(database)/documents/cins/$(request.resource.data.cin))
        && getAfter(/databases/$(database)/documents/cins/$(request.resource.data.cin)).data.uid == request.auth.uid;

      // Qui peut modifier une fiche :
      //  - l'administration (tout) ;
      //  - le coordinateur de la région : uniquement l'état des pièces ;
      //  - l'adhérent : corriger son profil (rien d'autre).
      allow update: if isAdmin()
        || coordinatorMayDecide(uid)
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['firstNameFr', 'lastNameFr', 'firstNameAr', 'lastNameAr', 'phone', 'profession', 'commune', 'photoUrl'])
          && request.resource.data.firstNameFr is string && request.resource.data.firstNameFr.size() > 0 && request.resource.data.firstNameFr.size() < 80
          && request.resource.data.lastNameFr is string && request.resource.data.lastNameFr.size() > 0 && request.resource.data.lastNameFr.size() < 80
          && request.resource.data.firstNameAr is string && request.resource.data.firstNameAr.size() < 80
          && request.resource.data.lastNameAr is string && request.resource.data.lastNameAr.size() < 80
          && request.resource.data.phone is string && request.resource.data.phone.size() < 30
          && request.resource.data.profession is string && request.resource.data.profession.size() < 120
          && request.resource.data.commune is string && request.resource.data.commune.size() < 120
          && request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() < 200000);

      allow delete: if false;
    }

    // Création seule : si la CIN existe déjà, l'écriture devient une mise à jour, refusée.
    match /cins/{cin} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Forum citoyen : lecture publique, écriture réservée aux adhérents.
    // ---------------------------------------------------------------------
    match /debates/{debateId} {
      allow read: if true;

      allow create: if isMember()
        && authorMatchesProfile()
        && request.resource.data.keys().hasOnly(['category', 'titleFr', 'titleAr', 'contentFr', 'contentAr', 'tags',
             'authorId', 'authorName', 'authorRegion', 'authorRole', 'createdAt', 'votesFor', 'votesAgainst',
             'votesNeutral', 'commentsCount', 'status'])
        && request.resource.data.category in ['economy', 'health_social', 'education_youth', 'water_ecology', 'governance', 'regional_development']
        && request.resource.data.titleFr is string && request.resource.data.titleFr.size() > 0 && request.resource.data.titleFr.size() <= 200
        && request.resource.data.titleAr is string && request.resource.data.titleAr.size() <= 200
        && request.resource.data.contentFr is string && request.resource.data.contentFr.size() > 0 && request.resource.data.contentFr.size() <= 5000
        && request.resource.data.contentAr is string && request.resource.data.contentAr.size() <= 5000
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 6
        && (request.resource.data.authorRole == 'Membre Adhérent PME' || isAdmin())
        && request.resource.data.createdAt == request.time
        && request.resource.data.votesFor == 0
        && request.resource.data.votesAgainst == 0
        && request.resource.data.votesNeutral == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.status == 'open';

      allow update: if isAdmin() || debateCommentCounter() || debateVoteCounter(debateId);
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isMember()
          && authorMatchesProfile()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorRegion', 'content', 'createdAt'])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1500
          && request.resource.data.createdAt == request.time;
        allow update, delete: if isAdmin();
      }
    }

    // Un document par (débat, membre) : l'identifiant garantit l'unicité du vote.
    match /debateVotes/{voteId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['debateId', 'uid', 'vote', 'at'])
        && request.resource.data.uid == request.auth.uid
        && voteId == request.resource.data.debateId + '_' + request.auth.uid
        && request.resource.data.vote in ['for', 'against', 'neutral']
        && request.resource.data.at == request.time
        && exists(/databases/$(database)/documents/debates/$(request.resource.data.debateId));
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Sondages et consultations : lecture publique, création par l'administration.
    // ---------------------------------------------------------------------
    match /polls/{pollId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || pollVoteCounter(pollId);
    }

    // Un vote par membre et par sondage, définitif (pas de mise à jour ni de suppression).
    // Les scrutins internes exigent un dossier complet (les quatre pièces validées).
    match /pollVotes/{voteId} {
      allow get, list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['pollId', 'uid', 'optionId', 'at'])
        && request.resource.data.uid == request.auth.uid
        && voteId == request.resource.data.pollId + '_' + request.auth.uid
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/polls/$(request.resource.data.pollId)).data.status == 'open'
        && (get(/databases/$(database)/documents/polls/$(request.resource.data.pollId)).data.type != 'internal_election'
            || dossierComplete());
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // Compteur de visiteurs : un seul document public, lisible par tous. Les visiteurs (même non connectés)
    // ne peuvent que l'augmenter, de 1 visite à la fois et d'au plus 1 visiteur unique : aucune autre donnée.
    // ---------------------------------------------------------------------
    match /stats/visits {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['total', 'unique'])
        && request.resource.data.total == 1
        && request.resource.data.unique == 1;
      allow update: if request.resource.data.keys().hasOnly(['total', 'unique'])
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.unique in [resource.data.unique, resource.data.unique + 1];
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
