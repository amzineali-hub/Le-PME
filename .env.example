# Configuration web Firebase (console Firebase > Paramètres du projet > Vos applications).
# Ces valeurs ne sont pas secrètes ; la sécurité repose sur firestore.rules.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# --- Assistant IA (fonction api/assistant.ts) : SECRET, jamais de préfixe VITE_ ---
# Clé Gemini : https://aistudio.google.com/apikey
# À mettre dans Vercel (Settings > Environment Variables) ; en local, dans .env.local pour tester avec « npm run dev ».
GEMINI_API_KEY=""
# Optionnel : modèle (par défaut « gemini-flash-latest », toujours le dernier modèle Flash).
GEMINI_MODEL=""
# Optionnel : autres sites autorisés à appeler l'assistant, séparés par des virgules (ex. un nom de domaine propre).
ALLOWED_ORIGINS=""
